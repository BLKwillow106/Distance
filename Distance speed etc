#include <iostream>
using namespace std;

int main() {
    int speed, hours;

    cout << "what is the speed of the vehicle in miles per hour? ";
    cin>> speed;
    cout << "how many hours did the vehicle travel? ";
    cin >> hours;
    int distance = speed * hours;
    cout << "the vehicle traveled " << distance << " miles." << endl;
    return 0;
}